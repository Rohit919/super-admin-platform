{
  "name": "@app/api-contracts",
  "version": "1.0.0",
  "description": "Shared TypeBox API contracts for the Gym Platform API, consumed by the API and its client applications (super-admin, tenant-web, mobile)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.32.5"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
