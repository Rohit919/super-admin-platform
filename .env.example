# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values before running the app.
# Values marked <required> have no default — the API will not start without them.
# The root .env is loaded by the Platform API (apps/platform-api). The Super
# Admin frontend reads VITE_ vars. This is the PLATFORM control-plane env — it is
# independent of any tenant/business system and must never contain another
# system's production secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development           # development | production | test
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info                 # trace | debug | info | warn | error | fatal

# ── Database ─────────────────────────────────────────────────────────────────
# <required> Platform DB connection string. Must point at the PLATFORM database
# (see docs/PLATFORM-DATABASE.md) — never a tenant/business system's database.
# LOCAL DEV (direct to Postgres):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platform_db
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/platform_db
#
# PRODUCTION (through PgBouncer, transaction pooling):
#   DATABASE_URL=postgresql://user:pass@pgbouncer:6432/db?pgbouncer=true&connection_limit=1
#   DATABASE_DIRECT_URL=postgresql://user:pass@postgres:5432/db?sslmode=require
# With PgBouncer as the pool, keep Prisma's own pool at connection_limit=1.
# Sizing: DEFAULT_POOL_SIZE ≈ (avg concurrent queries) — 20 handles most single
# instances; MAX_CLIENT_CONN caps total app connections (200 default).
# directUrl is used only by `prisma migrate`/introspection (needs a direct session).

# ── Redis ────────────────────────────────────────────────────────────────────
# Distributed rate limiting + BullMQ queues. API fails open if Redis is unreachable.
REDIS_URL=redis://localhost:6379

# ── Authentication ───────────────────────────────────────────────────────────
# <required> Signing secret — should be at least 32 characters
JWT_SECRET=replace-with-a-32-char-minimum-random-secret
JWT_EXPIRES_IN=15m             # access token lifetime (keep short)
REFRESH_TOKEN_EXPIRES_IN=7d    # refresh token lifetime
HTTPS_ONLY=false               # set true in production — Secure flag on refresh cookie

# ── Secrets provider ─────────────────────────────────────────────────────────
# env (default) | aws | vault | doppler — where loadSecrets() fetches from at boot
SECRETS_PROVIDER=env

# ── API ──────────────────────────────────────────────────────────────────────
API_PREFIX=/api
API_VERSION=v1

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100             # requests per window
RATE_LIMIT_TIME_WINDOW=60000   # window in ms (60s)

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins — no trailing slashes.
# In dev the admin runs on :5173.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# ── Monitoring ───────────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PATH=/metrics
# Optional: bearer token to protect /metrics (min 20 chars). Leave empty for open access in dev.
METRICS_TOKEN=

# ── API Documentation ────────────────────────────────────────────────────────
# Disabled by default. Enable explicitly for local dev; keep false in production.
SWAGGER_ENABLED=false
SWAGGER_PATH=/documentation

# ── Tracing (OpenTelemetry) ──────────────────────────────────────────────────
# Opt-in. When true, spans export to the OTLP endpoint (Jaeger in docker-compose).
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=platform-api

# ── White-label branding (GET /api/v1/branding) ──────────────────────────────
# Default (single-tenant) branding the Admin applies at runtime. A multi-tenant
# deployment resolves branding per tenant in the branding route instead.
# See docs/white-label/WHITE-LABEL-RUNTIME-CONFIG.md.
BRAND_APP_NAME=Super Admin Platform
BRAND_SHORT_NAME=Super Admin
# Colors accept hex, rgb(), hsl(), or a bare "H S% L%" triplet.
BRAND_COLOR_PRIMARY=#4f46e5
# BRAND_COLOR_SECONDARY=
# BRAND_COLOR_ACCENT=
# Asset URLs must be https or same-origin relative paths (start with /).
# BRAND_LOGO=/brand/logo.svg
# BRAND_LOGO_DARK=/brand/logo-dark.svg
# BRAND_ICON=/brand/icon.svg
# BRAND_FAVICON=/brand/favicon.svg
# BRAND_COMPANY_NAME=Super Admin Platform
# BRAND_DESCRIPTION=Secure admin control panel.

# ── Super Admin frontend (apps/super-admin, Vite) ─────────────────────────────
# Base URL the frontend calls. In dev, leave as /api/v1 (Vite proxies to the API).
VITE_API_BASE_URL=/api/v1

# ── Alertmanager webhook receivers ────────────────────────────────────────────
# Alertmanager routes firing alerts to these webhook URLs.
# In dev the defaults point to a local sink (localhost:9999) so the stack starts
# without external dependencies. Override in production with real endpoints
# (Slack incoming-webhook, PagerDuty events API, etc.).
ALERTMANAGER_WEBHOOK_URL=http://host.docker.internal:9999/alerts
ALERTMANAGER_CRITICAL_WEBHOOK_URL=http://host.docker.internal:9999/alerts/critical
# ── Database seed (prisma db seed) ────────────────────────────────────────────
# Used only by `npm run db:seed` to create the initial administrator.
# There is NO default password — the seed refuses to run without one.
# In production, the seed also requires SEED_ALLOW_PRODUCTION=true.
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password
SEED_ADMIN_NAME=Platform Admin
# SEED_ALLOW_PRODUCTION=false
